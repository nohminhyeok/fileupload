<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>게시글 작성</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=SUIT:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-light: #f9f9f9;
      --text-light: #1f1f1f;
      --card-bg-light: #ffffff;
      --highlight: #00b894;

      --bg-dark: #2a2a2a;
      --text-dark: #eeeeee;
      --card-bg-dark: #3b3b3b;
      --text-muted-dark: #cccccc;
    }

    * {
      font-family: 'SUIT', sans-serif;
    }

    body[data-theme="light"] {
      background-color: var(--bg-light);
      color: var(--text-light);
    }

    body[data-theme="dark"] {
      background-color: var(--bg-dark);
      color: var(--text-dark);
    }

    .form-card {
      max-width: 700px;
      margin: 60px auto;
      background-color: var(--card-bg-light);
      border-radius: 16px;
      padding: 40px 30px;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.05);
      transition: background-color 0.3s;
    }

    body[data-theme="dark"] .form-card {
      background-color: var(--card-bg-dark);
    }

    h1 {
      font-weight: 700;
      font-size: 2rem;
      margin-bottom: 30px;
      text-align: center;
    }

    .form-label {
      font-weight: 600;
      margin-bottom: 6px;
    }

    .form-control, .form-control:focus {
      border-radius: 10px;
      box-shadow: none;
    }

    .btn-submit {
      background-color: var(--highlight);
      color: white;
      font-weight: 600;
      padding: 12px 20px;
      border-radius: 12px;
      border: none;
      transition: all 0.3s ease;
      width: 100%;
      margin-top: 10px;
    }

    .btn-submit:hover {
      background-color: #00a282;
    }

    .form-header {
      text-align: center;
      font-size: 3rem;
      margin-bottom: 10px;
    }

    .form-header span {
      font-size: 2.8rem;
    }

    .upload-hint {
      font-size: 0.9rem;
      color: #888;
      margin-top: 4px;
    }

    body[data-theme="dark"] .upload-hint {
      color: var(--text-muted-dark);
    }
  </style>
</head>
<body data-theme="light">

  <div class="form-card">
    <div class="form-header">📝 <span>글 작성</span></div>

    <form method="post" action="/addBoard" enctype="multipart/form-data">
      <div class="mb-3">
        <label class="form-label">제목</label>
        <input type="text" name="title" class="form-control" placeholder="게시글 제목을 입력하세요" required>
      </div>

      <div class="mb-3">
        <label class="form-label">비밀번호</label>
        <input type="password" name="pw" class="form-control" placeholder="삭제 시 필요한 비밀번호" required>
      </div>

      <div class="mb-4">
        <label class="form-label">첨부파일</label>
        <input type="file" name="fileList" class="form-control" multiple>
        <div class="upload-hint">여러 개 선택 가능</div>
      </div>

      <button type="submit" class="btn-submit">✅ 저장하기</button>
    </form>
  </div>

  <script>
    const saved = localStorage.getItem('theme') || 'light';
    document.body.setAttribute('data-theme', saved);
  </script>

</body>
</html>