<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>boardList.mustache</title>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>게시판</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=SUIT:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-light: #f9f9f9;
      --text-light: #1f1f1f;
      --card-bg-light: #ffffff;
      --highlight: #00b894;

      --bg-dark: #2a2a2a;
      --text-dark: #eeeeee;
      --card-bg-dark: #3b3b3b;
      --text-muted-dark: #cccccc;
    }

    * {
      font-family: 'SUIT', sans-serif;
    }

    body[data-theme="light"] {
      background-color: var(--bg-light);
      color: var(--text-light);
    }

    body[data-theme="dark"] {
      background-color: var(--bg-dark);
      color: var(--text-dark);
    }

    .board-container {
      max-width: 1100px;
      margin: auto;
      padding: 30px 15px;
    }

    .board-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 30px;
      color: #999;
    }

    .board-header h1 {
      font-size: 2.5rem;
      font-weight: 700;
    }

    .msg {
      background-color: #fff3cd;
      color: #856404;
      padding: 12px;
      border-radius: 8px;
      font-weight: bold;
      margin-bottom: 20px;
    }

    .card {
      border: none;
      border-radius: 16px;
      box-shadow: 0 6px 16px rgba(0, 0, 0, 0.05);
      transition: transform 0.3s ease, background-color 0.3s;
    }

    .card:hover {
      transform: translateY(-4px);
      box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
    }

    [data-theme="light"] .card {
      background-color: var(--card-bg-light);
    }

    [data-theme="dark"] .card {
      background-color: var(--card-bg-dark);
    }

    .card-title {
      font-size: 0.9rem;
      color: var(--text-muted-dark);
    }

    [data-theme="light"] .card-title {
      color: #888;
    }

    [data-theme="dark"] .card-title {
      color: var(--text-muted-dark);
    }

    .fw-semibold a {
      text-decoration: none;
      font-size: 1.2rem;
      font-weight: 600;
      color: green;
    }

    .fw-semibold a:hover {
      color: var(--highlight);
    }

    .btn-toggle-theme {
      transition: all 0.3s ease;
    }

    .pagination .page-item.active .page-link {
      background-color: var(--highlight);
      border-color: var(--highlight);
      color: #fff;
    }

    .pagination .page-link {
      border-radius: 10px;
    }
  </style>
</head>
<body data-theme="light">
  <div class="board-container">
    <div class="board-header">
      <h1>📋 게시판</h1>
      <div>
        <a href="/addBoard" class="btn btn-primary shadow me-2">+ 새 글 작성</a>
        <button class="btn btn-outline-secondary btn-toggle-theme">🌙 다크모드</button>
      </div>
    </div>

    {{#msg}}
    <div class="msg">{{msg}}</div>
    {{/msg}}

    <form method="get" action="/boardList" class="input-group mb-4">
      <input type="text" name="word" value="{{word}}" class="form-control" placeholder="제목 검색">
      <button type="submit" class="btn btn-outline-secondary">검색</button>
    </form>

    <div class="row g-4">
      {{#list}}
      <div class="col-md-6 col-lg-4">
        <div class="card p-4">
          <div class="card-title">No. {{bno}}</div>
          <div class="fw-semibold">
            <a href="/boardOne?bno={{bno}}">{{title}}</a>
          </div>
        </div>
      </div>
      {{/list}}
    </div>

    <nav class="mt-5">
      <ul class="pagination justify-content-center">
        {{^list.isFirst}}
        <li class="page-item">
          <a class="page-link" href="/boardList?currentPage={{prePage}}&word={{word}}">이전</a>
        </li>
        {{/list.isFirst}}

        <li class="page-item active">
          <span class="page-link">{{currentPage}}</span>
        </li>

        {{#list.hasNext}}
        <li class="page-item">
          <a class="page-link" href="/boardList?currentPage={{nextPage}}&word={{word}}">다음</a>
        </li>
        {{/list.hasNext}}
      </ul>
    </nav>
  </div>

  <script>
    const toggleBtn = document.querySelector('.btn-toggle-theme');
    const body = document.body;

    const updateTheme = (theme) => {
      body.setAttribute('data-theme', theme);
      toggleBtn.textContent = theme === 'light' ? '🌙 다크모드' : '☀️ 라이트모드';
      toggleBtn.classList.toggle('btn-outline-dark', theme === 'light');
      toggleBtn.classList.toggle('btn-outline-light', theme === 'dark');
      localStorage.setItem('theme', theme);
    };

    toggleBtn.addEventListener('click', () => {
      const currentTheme = body.getAttribute('data-theme');
      updateTheme(currentTheme === 'light' ? 'dark' : 'light');
    });

    window.addEventListener('DOMContentLoaded', () => {
      const saved = localStorage.getItem('theme') || 'light';
      updateTheme(saved);
    });
  </script>
</body>
</html>